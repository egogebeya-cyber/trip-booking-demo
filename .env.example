DATABASE_URL=./data/trip-booking.db
SESSION_SECRET=change-me-in-production
APP_URL=http://localhost:3001

# Real email: fill SMTP below, or set RESEND_API_KEY.
# You can also enter SMTP in Admin → Settings (recommended).
EMAIL_ENABLED=true
EMAIL_FROM=Trip Explorer <you@gmail.com>

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

RESEND_API_KEY=

# Optional. Day-before trip reminder SMS via AfroMessage (https://afromessage.com).
# Leave off until you have a token. Email reminders still send the day before.
SMS_ENABLED=false
SMS_API_TOKEN=
SMS_SENDER=TripExplorer
SMS_FROM=
